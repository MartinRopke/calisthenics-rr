{
  "name": "calisthenics-rr",
  "version": "1.0.0",
  "private": true,
  "description": "Workout app for the Recommended Routine of r/bodyweightfitness",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "home": "caffeinate -i node server.mjs",
    "test": "node --test \"test/unit/**/*.test.js\" \"test/server/*.test.js\"",
    "e2e:install": "playwright install chromium",
    "test:e2e": "node --test --test-concurrency=1 --test-timeout=180000 \"test/e2e/*.e2e.js\"",
    "guide": "node scripts/generate-guide.mjs",
    "wiki": "node scripts/fetch-wiki.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1"
  }
}
